rules_version = '2';

/**
 * @name ChargeAssist Firestore Security Rules
 * @author AI-Generated (Prototyping Mode)
 *
 * @description
 * This ruleset is designed for the ChargeAssist application, providing a secure
 * yet flexible data access layer suitable for rapid development and iteration.
 * It is based on a centralized request model for scalability and security.
 *
 * @philosophy
 * Core Philosophy: The security model employs a hybrid approach. It uses strict,
 * path-based ownership for user-specific data (profiles). For administrative
 * functions, it uses Database-Based Access Control (DBAC), where admin privileges
 * are granted by the existence of a document in a specific roles collection.
 * Public data, like charging stations, is readable by all users to facilitate discovery.
 * All user-generated actions (bookings, emergencies) are funneled through a
 * single `bookingRequests` collection, which has granular access controls.
 *
 * @structure
 * Data Structure:
 * - /users/{userId} - Private user profile.
 * - /charging_stations/{stationId} - Publicly viewable charging stations, managed by admins.
 * - /bookingRequests/{requestId} - Central collection for all user-initiated requests (bookings, emergencies).
 *   Users can create requests and read only their own. Admins have full CRUD access.
 * - /roles_admin/{userId} - A private lookup collection to designate admins.
 *
 * @decisions
 * Key Security Decisions:
 * - Default Deny: All paths are closed by default. Access is granted explicitly.
 * - User Data Privacy: The top-level `/users` collection cannot be listed.
 * - Centralized Requests: Consolidating requests into a single collection
 *   simplifies admin oversight and security rules.
 * - Admin Control: A dedicated `/roles_admin` collection serves as the single
 *   source of truth for administrative privileges.
 * - Denormalization for Security: Request documents contain a denormalized 'userId'
 *   field, which is critical for writing security rules that allow users to read
 *   only their own documents.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Manages public charging station information.
     */
    match /charging_stations/{stationId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Central collection for all booking and emergency requests.
     * @principle Users can create their own requests and read only their own requests.
     *            Admins can list, read, and manage all requests.
     */
    match /bookingRequests/{requestId} {
        // A user can create a request if they are signed in.
        allow create: if isSignedIn();
        
        // A user can read a request only if it belongs to them.
        allow get: if isSignedIn() && resource.data.userId == request.auth.uid;

        // Admins can update, or delete any specific request.
        allow update, delete: if isAdmin();

        // Admins can list all documents in the collection and read any single document.
        allow list, get: if isAdmin();
    }

    /**
     * @description A private collection that grants admin privileges via document existence.
     * @principle No client operation is allowed. Access is for server-side rules logic only.
     */
    match /roles_admin/{userId} {
      allow get, list, create, update, delete: if false;
    }
  }
}
