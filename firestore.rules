rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // USERS can only read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // CHARGING STATIONS are public to read, but only admins can modify them
    match /charging_stations/{stationId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // BOOKING REQUESTS can be created by any authenticated user,
    // but only the user who created it can read it, and only admins can manage it.
    match /bookingRequests/{docId} {
      // Any authenticated user can create a booking request
      allow create: if request.auth != null;

      // A user can read their own booking request document
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Admins have full list, read, update, and delete access
      allow list, read, update, delete: if isAdmin();
    }

    // roles_admin collection is now deprecated in favor of custom claims,
    // so it is locked down.
    match /roles_admin/{userId} {
      allow read, write: if false;
    }
  }
}
